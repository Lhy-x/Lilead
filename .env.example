# API
PORT=4000
CLIENT_URL=http://localhost:3000
JWT_SECRET=change-me

# Base de données
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lilead

# Emails (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=no-reply@yourdomain.com

# IA (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Vérification email
VERIFICATION_EXPIRY_MINUTES=30

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
