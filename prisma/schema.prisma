generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

enum QuestionType {
  EMAIL
  PHONE
  SHORT_TEXT
  LONG_TEXT
  CHATBOX
}

enum LeadStatus {
  PENDING
  QUALIFIED
  DISQUALIFIED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  companyName   String?
  brandColor    String?  @db.VarChar(32)
  themePreference String? @db.VarChar(16)
  emailVerified Boolean  @default(false)
  role          UserRole @default(ADMIN)
  forms         Form[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Form {
  id               String        @id @default(uuid())
  user             User          @relation(fields: [userId], references: [id])
  userId           String
  name             String
  slug             String        @unique
  description      String?
  accentColor      String?       @db.VarChar(32)
  theme            String?       @db.VarChar(16)
  isPublished      Boolean       @default(false)
  successTitle     String?       @db.VarChar(255)
  successMessage   String?
  successVideoUrl  String?
  enableTestMode   Boolean       @default(false)
  questions        Question[]
  submissions      Submission[]
  visits           Visit[]
  leadRules        LeadRule[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Question {
  id          String       @id @default(uuid())
  form        Form         @relation(fields: [formId], references: [id])
  formId      String
  label       String
  helperText  String?
  type        QuestionType
  isRequired  Boolean      @default(false)
  order       Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  answers     Answer[]
}

model Submission {
  id              String        @id @default(uuid())
  form            Form          @relation(fields: [formId], references: [id])
  formId          String
  leadEmail       String?
  leadPhone       String?
  status          LeadStatus    @default(PENDING)
  aiScore         Float?
  aiSummary       String?
  verification    EmailVerification?
  answers         Answer[]
  isTestSubmission Boolean      @default(false)
  createdAt       DateTime      @default(now())
}

model Answer {
  id           String      @id @default(uuid())
  submission   Submission  @relation(fields: [submissionId], references: [id])
  submissionId String
  question     Question    @relation(fields: [questionId], references: [id])
  questionId   String
  value        String
  createdAt    DateTime    @default(now())
}

model EmailVerification {
  id           String      @id @default(uuid())
  submission   Submission? @relation(fields: [submissionId], references: [id])
  submissionId String?
  email        String
  form         Form        @relation(fields: [formId], references: [id])
  formId       String
  code         String
  verifiedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([email, formId], map: "email_formId")
}

model Visit {
  id         String   @id @default(uuid())
  form       Form     @relation(fields: [formId], references: [id])
  formId     String
  visitorId  String   @db.VarChar(128)
  ipHash     String   @db.VarChar(128)
  userAgent  String?
  createdAt  DateTime @default(now())
}

model EmailLog {
  id         String   @id @default(uuid())
  form       Form?    @relation(fields: [formId], references: [id])
  formId     String?
  submission Submission? @relation(fields: [submissionId], references: [id])
  submissionId String?
  toEmail    String
  template   String
  sentAt     DateTime @default(now())
  status     String   @db.VarChar(32)
  error      String?
}

model LeadRule {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  form      Form?    @relation(fields: [formId], references: [id])
  formId    String?
  fieldKey  String
  operator  String
  value     String
  weight    Float    @default(1)
  createdAt DateTime @default(now())
}
